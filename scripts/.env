# ===================== SMTP =====================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ===================== E-mails ==================
ALERT_FROM=nao-responda@a12.com.br
ALERT_TO=equipe.desenvolvimento@a12.com
ALERT_SUBJECT=[MONITOR YT] Relatório diário

# ============== ALERTA DE ERRO ==================
ALERT_ON_ERROR=1
ALERT_ERROR_TO=equipe.desenvolvimento@a12.com
ALERT_ERROR_SUBJECT=[MONITOR YT] Falha no monitor
ALERT_ERROR_COOLDOWN_MIN=15
ALERT_ERROR_INCLUDE_TRACE=1

BLOCK_MEDIA=1
BLOCK_MEDIA_EXT=jpg,jpeg,png,gif,webp,mp4,m4s,webm,m3u8,ts
MOBILE_UA=0

CLEAR_CSV_AFTER_DAILY=1

ANOMALY_LOG=anomalies.log

# Opção A (recomendada): vários horários por dia DAILY_SEND_TIMES=00:01;12:00;18:30
DAILY_SEND_TIMES=07:49

# Janela de tolerância em minutos (para não perder o horário se o Agendador rodar a cada X min)
DAILY_SEND_TOLERANCE_MINUTES=6
# Compatibilidade com versões antigas (opcional)
# DAILY_SEND_WINDOW_MIN=6

# Opção B (compatibilidade): use SOMENTE se DAILY_SEND_TIMES estiver vazio
DAILY_SEND_HOUR=0
DAILY_SEND_MINUTE=1

OUTLIER_ABS_MAX=5000000

RETRY_READS=3
RETRY_SLEEP_MS=1000
