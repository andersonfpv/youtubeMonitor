# Copie para .env e preencha localmente. Nunca publique credenciais.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_FROM=
ALERT_TO=
ALERT_SUBJECT=[MONITOR YT] Relatório diário
DAILY_SEND_TIMES=08:57;09:00;09:05
DAILY_SEND_TOLERANCE_MINUTES=6
CLEAR_CSV_AFTER_DAILY=1
BLOCK_MEDIA=1
BLOCK_MEDIA_EXT=jpg,jpeg,png,gif,webp,mp4,m4s,webm,m3u8,ts
RETRY_READS=3
RETRY_SLEEP_MS=1000
OUTLIER_ABS_MAX=5000000
COLLECT_INTERVAL_SECONDS=180
COLLECT_TIMEOUT_SECONDS=150
